; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tideways"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1600
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

hud_toggle_pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

hud_speed_normal={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}

hud_speed_fast={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}

hud_speed_fastest={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

hud_clear_selection={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

hud_next_ferry={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}

hud_regenerate_map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71)]
}

hud_quick_save={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194336)]
}

hud_speed_max={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}

hud_return_to_menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}

hud_light_previous_hour={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":91)]
}

hud_light_next_hour={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":93)]
}

hud_light_follow_clock={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":84)]
}

hud_weather_cycle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86)]
}

hud_weather_resume={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":86,"shift_pressed":true)]
}

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/screen_space_aa=2
scaling_3d/scale.ios=0.9

[shader_globals]

cloud_coverage={
"type": "float",
"value": 0.45
}
cloud_wind={
"type": "vec2",
"value": Vector2(3, 1.5)
}
cloud_shadow_strength={
"type": "float",
"value": 0.55
}
sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
night_lights={
"type": "float",
"value": 0.0
}
sun_light={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
sky_zenith={
"type": "vec3",
"value": Vector3(0.1, 0.27, 0.6)
}
haze_sky={
"type": "vec3",
"value": Vector3(0.5, 0.65, 0.78)
}
haze_fog={
"type": "vec3",
"value": Vector3(0.5, 0.63, 0.74)
}
fog_range={
"type": "vec2",
"value": Vector2(600, 1600)
}
horizon_clouds={
"type": "vec4",
"value": Vector4(0.6, 0.14, 0.95, 0.35)
}
cloud_storm={
"type": "float",
"value": 0.0
}
road_wet={
"type": "float",
"value": 0.0
}
cloud_time={
"type": "float",
"value": 0.0
}
focus_distance={
"type": "float",
"value": 380.0
}
