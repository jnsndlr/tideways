[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/departure_board.gd" id="2"]
[ext_resource type="Script" path="res://scripts/ui/harbor_window.gd" id="3"]
[ext_resource type="Shader" path="res://scripts/ui/harbor_glass.gdshader" id="4"]

[sub_resource type="ShaderMaterial" id="HarborGlass"]
resource_local_to_scene = true
shader = ExtResource("4")

[sub_resource type="SystemFont" id="FaceFont"]
font_names = PackedStringArray("Avenir Next", "Helvetica Neue", "DejaVu Sans")
font_weight = 650

[sub_resource type="StyleBoxEmpty" id="Bare"]

[sub_resource type="StyleBoxFlat" id="Active"]
bg_color = Color(1, 0.78, 0.36, 0.08)

[sub_resource type="StyleBoxFlat" id="Focus"]
draw_center = false
border_width_left = 3
border_color = Color(1, 0.84, 0.52, 0.85)

[sub_resource type="Theme" id="BoardTheme"]
Label/fonts/font = SubResource("FaceFont")
Button/colors/font_color = Color(1, 1, 1, 0)
Button/colors/font_focus_color = Color(1, 1, 1, 0)
Button/colors/font_hover_color = Color(1, 1, 1, 0)
Button/colors/font_pressed_color = Color(1, 1, 1, 0)
Button/colors/font_hover_pressed_color = Color(1, 1, 1, 0)
Button/styles/normal = SubResource("Bare")
Button/styles/focus = SubResource("Focus")
Button/styles/pressed = SubResource("Active")
Button/styles/hover = SubResource("Active")

[node name="Menu" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Terminal" type="TextureRect" parent="."]
mouse_filter = 2
expand_mode = 1

[node name="Harbor" type="VideoStreamPlayer" parent="Terminal"]
