[node name="PortraitBoard" type="Polygon2D" parent="Board"]

[node name="Faces" type="Node2D" parent="Board"]

[node name="Rows" type="Control" parent="Board"]
mouse_filter = 2

[node name="Departures" type="Control" parent="Board/Rows"]
mouse_filter = 2

[node name="Continue" type="Button" parent="Board/Rows/Departures"]
